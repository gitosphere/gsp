#compdef gsp

__gsp_complete() {
    local -ar non_empty_completions=("${@:#(|:*)}")
    local -ar empty_completions=("${(M)@:#(|:*)}")
    _describe -V '' non_empty_completions -- empty_completions -P $'\'\''
}

__gsp_custom_complete() {
    local -a completions
    completions=("${(@f)"$("${command_name}" "${@}" "${command_line[@]}")"}")
    if [[ "${#completions[@]}" -gt 1 ]]; then
        __gsp_complete "${completions[@]:0:-1}"
    fi
}

__gsp_cursor_index_in_current_word() {
    if [[ -z "${QIPREFIX}${IPREFIX}${PREFIX}" ]]; then
        printf 0
    else
        printf %s "${#${(z)LBUFFER}[-1]}"
    fi
}

_gsp() {
    emulate -RL zsh -G
    setopt extendedglob nullglob numericglobsort
    unsetopt aliases banghist

    local -xr SAP_SHELL=zsh
    local -x SAP_SHELL_VERSION
    SAP_SHELL_VERSION="$(builtin emulate zsh -c 'printf %s "${ZSH_VERSION}"')"
    local -r SAP_SHELL_VERSION

    local context state state_descr line
    local -A opt_args

    local -r command_name="${words[1]}"
    local -ar command_line=("${words[@]}")
    local -ir current_word_index="$((CURRENT - 1))"

    local -i ret=1
    local -ar ___session_store=('keychain' 'file')
    local -ar arg_specs=(
        '--json[Emit stable machine-readable JSON]'
        '--verbose[Emit diagnostic details]'
        '--non-interactive[Disable all interactive prompts]'
        '--profile[Select a configured profile]:profile:'
        '--timeout-seconds[Request timeout in seconds]:timeout-seconds:'
        '--session-store[Session storage\: keychain or file]:session-store:{__gsp_complete "${___session_store[@]}"}'
        '--version[Show the version.]'
        '(-h --help)'{-h,--help}'[Show help information.]'
        '(-): :->command'
        '(-)*:: :->arg'
    )
    _arguments -w -s -S : "${arg_specs[@]}" && ret=0
    case "${state}" in
    command)
        local -ar subcommands=(
            'auth:Manage Gitosphere authentication'
            'org:Manage Gitosphere Organizations'
            'member:Manage Gitosphere membership independently of Space membership'
            'repo:Manage Gitosphere repositories'
            'space:Manage Permissioned Data Spaces'
            'traffic:Inspect admission limits and pause or resume new requests'
            'quota:Inspect usage and manage service quotas'
            'invite:Manage service invitations'
            'access:Inspect Gitosphere authorization decisions'
            'audit:Inspect secret-safe Gitosphere audit events'
            'issue:Manage issues in a Gitosphere repository'
            'pr:Manage pull requests in a Gitosphere repository'
            'events:Read the event feed of a repository'
            'completion:Generate a shell completion script'
            'help:Show subcommand help information.'
        )
        _describe -V subcommand subcommands && ret=0
        ;;
    arg)
        case "${words[1]}" in
        auth|org|member|repo|space|traffic|quota|invite|access|audit|issue|pr|events|completion|help)
            "_gsp_${words[1]}" && ret=0
            ;;
        esac
        ;;
    esac

    return "${ret}"
}

